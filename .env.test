NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_builder_test
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
ENCRYPTION_KEY=dev-only-encryption-key-change-me-0123456789abcdef
MAIL_TRANSPORT=log
REDIS_URL=redis://127.0.0.1:6379/1
TRUST_PROXY=1
LOG_LEVEL=silent
STORAGE_DIR=/tmp/cloudbase-test-storage
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=cloudbase-dev-livekit-secret-0123456789abcdef
# Permission-set add-ons (extra access on top of role + profile). true = on, false = the feature never runs.
ACCESS_ADDONS_ENABLED=true
# Integrations may only target public addresses unless this is true (on-premise installs, tests).
INTEGRATIONS_ALLOW_PRIVATE_HOSTS=true
# Deployments system app: servers, projects, services, deploys. true = on, false = never runs.
DEPLOYMENTS_ENABLED=true
# Allow Deployments to run Docker on the API's own machine (otherwise only SSH-connected servers).
DEPLOYMENTS_ALLOW_LOCAL=false
