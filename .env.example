NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_builder
DB_POOL_MAX=20
LOG_LEVEL=info
TRUST_PROXY=0                 # set to the number of reverse proxies in front of the API (needed for correct client IPs)
WORKER_CONCURRENCY=5

# Scale / performance (see docs/setup-engine.md)
REDIS_URL=redis://127.0.0.1:6379   # shared cache + cross-process invalidation; unset = in-process cache only
API_WORKERS=1                      # >1 = prefork: a supervisor forks this many API processes (use ~cores - 1)
API_MAX_REQUESTS=100000            # a worker retires (gracefully, replacement first) after this many requests...
API_MAX_RSS_MB=1024                # ...or when its memory passes this
DB_STATEMENT_TIMEOUT_MS=8000       # kills runaway queries
DB_READ_REPLICA_URL=               # optional: dashboards/reads go here
SETUP_REQUESTS_PER_MINUTE=6000     # per-workspace ceiling on Setup API calls (noisy-neighbour guard)
SETUP_SEED_SAMPLE_DATA=true        # fill empty Setup lists with the design's sample rows on first open
LOG_ACCESS=false                   # true = log every successful request (errors are always logged)

# Secrets — generate with: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
ENCRYPTION_KEY=change-me-change-me-change-me-change-me
COOKIE_SECURE=false           # true in production (HTTPS)

# Mail: "log" prints emails in the worker log; "smtp" sends via SMTP (Mailpit in docker compose on :1025, UI on :8025)
MAIL_TRANSPORT=smtp
MAIL_FROM=Quelli <noreply@quelli.example>
SMTP_HOST=localhost
SMTP_PORT=1025

# Optional Google sign-in (redirect URI: ${APP_URL}/api/v1/auth/oauth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Documents (Drive): where uploaded bytes live (local driver), largest single file, and total storage per workspace
STORAGE_DIR=./storage
MAX_UPLOAD_MB=100
DRIVE_QUOTA_MB=10240

# Calls (LiveKit). Local dev on macOS/Linux: `brew install livekit && livekit-server --dev` (key devkey / secret, ws://localhost:7880).
# Leave unset to turn calls off. Production: your own LiveKit cluster or LiveKit Cloud (wss://…). See docs/calls-local-dev.md.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=cloudbase-dev-livekit-secret-0123456789abcdef
# Permission-set add-ons (extra access on top of role + profile). true = on, false = the feature never runs.
ACCESS_ADDONS_ENABLED=false
# Integrations may only target public addresses unless this is true (on-premise installs, tests).
INTEGRATIONS_ALLOW_PRIVATE_HOSTS=false
